[Unit]
Description=gh-runnerd ephemeral GitHub Actions runners
Documentation=https://github.com/RefireLab/gh-runnerd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/gh-runnerd serve --config /etc/gh-runnerd/config.toml
Restart=on-failure
RestartSec=5
User=root
LimitNOFILE=1048576
DeviceAllow=/dev/kvm rw
DeviceAllow=/dev/vhost-vsock rw
DeviceAllow=/dev/net/tun rw
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
