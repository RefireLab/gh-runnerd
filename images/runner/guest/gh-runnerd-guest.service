[Unit]
Description=gh-runnerd guest agent
After=network-online.target docker.service
Wants=network-online.target
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/local/bin/gh-runnerd-guest
Restart=on-failure
RestartSec=2
Environment=GH_RUNNERD_HOST=10.87.0.1
Environment=GH_RUNNERD_RUNNER_DIR=/opt/actions-runner

[Install]
WantedBy=multi-user.target
